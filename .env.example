# Name of the Docker network shared with the existing messenger-postgres container.
# Find it with: docker inspect -f '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}' messenger-postgres
POSTGRES_NETWORK=messenger_default

# Create this dedicated database role/database in messenger-postgres before deployment.
POSTGRES_DB=nord-shop
POSTGRES_USER=nord-shop_app
# Use a long alphanumeric password. Put exactly the same value into PostgreSQL and here.
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_RANDOM_PASSWORD

# At least 32 UTF-8 bytes. Generate with: openssl rand -base64 48
JWT_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_JWT_SECRET
